# dependencies (bun install)
node_modules

# The pinned FMG checkout, when rebuilding the fork (see README §Rebuilding the fork).
# The built fork in clients/fmg/dist IS tracked, so this is only needed to rebuild.
/fmg-src

# output
out
/dist
/clients/fmg/dist-electron
*.tgz

# code coverage
coverage
*.lcov

# logs
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

*.tsbuildinfo

# User-provided FMG world saves + large source exports: never derived, never rewritten.
maps/source/*.map
maps/source/*.json

# Derived caches: regenerated by `bun dev` on start.
maps/generated/
maps/packs/

# Playwright E2E artifacts (screenshots)
test/e2e/artifacts/
