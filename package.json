{
  "name": "astral-cartographer",
  "version": "0.1.0",
  "description": "Astral Cartographer — a star-sector map mod for Azgaar's Fantasy Map Generator: the same world generator, reskinned as a sci-fi star map.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server/index.ts",
    "build": "bun run astral/build/build.ts",
    "build:watch": "bun run astral/build/build.ts -- --watch",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^5.9.3"
  }
}
